{
    "manifest_version": 3,
    "name": "Mentee Progress Sync",
    "version": "1.0",
    "description": "Silently syncs your Scaler problem-solving progress with your TA.",
    "permissions": [
      "storage",
      "alarms",
      "notifications"
    ],
    "host_permissions": [
      "https://www.scaler.com/*",
      "http://localhost:3000/*" 
    ],
    "background": {
      "service_worker": "background.js"
    },
    "action": {
      "default_popup": "popup.html",
      "default_title": "Setup Sync"
    }
  }